<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Nefarius.PowerConnect.Ews</RootNamespace>
        <AssemblyName>Nefarius.PowerConnect.Ews</AssemblyName>
        <PackageId>Nefarius.PowerConnect.Ews</PackageId>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/nefarius/PowerConnectCli</RepositoryUrl>
        <PackageProjectUrl>https://github.com/nefarius/PowerConnectCli</PackageProjectUrl>
        <Description>Client library for the Dell PowerConnect 28xx embedded web UI.</Description>
        <PackageTags>dell;powerconnect;networking;vlan</PackageTags>
        <MinVerTagPrefix>v</MinVerTagPrefix>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Nefarius.PowerConnect.Ews.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AngleSharp" Version="1.5.1" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="MinVer" Version="6.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Serilog" Version="4.3.0" />
    </ItemGroup>

</Project>
