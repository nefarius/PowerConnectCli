<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>pc28xx</AssemblyName>
        <RootNamespace>Nefarius.PowerConnect.Cli</RootNamespace>
        <LangVersion>latest</LangVersion>

        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>pc28xx</ToolCommandName>
        <PackageId>Nefarius.PowerConnect.CLI</PackageId>
        <Authors>Benjamin Höglinger-Stelzer</Authors>
        <Copyright>Copyright © Benjamin Höglinger-Stelzer 2026</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/nefarius/PowerConnectCli</RepositoryUrl>
        <PackageProjectUrl>https://github.com/nefarius/PowerConnectCli</PackageProjectUrl>
        <Description>Command-line tool for configuring a Dell PowerConnect 28xx switch through its embedded web UI.</Description>
        <PackageTags>dell;powerconnect;networking;vlan;cli;dotnet-tool</PackageTags>
        <PackageIcon>NSS-128x128.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <MinVerTagPrefix>v</MinVerTagPrefix>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)..\..\assets\NSS-128x128.png" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MinVer" Version="6.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Spectre.Console" Version="0.57.2" />
        <PackageReference Include="System.CommandLine" Version="2.0.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\lib\Nefarius.PowerConnect.Ews\Nefarius.PowerConnect.Ews.csproj" />
    </ItemGroup>

</Project>
